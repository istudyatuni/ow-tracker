# where companion app should connect (without port)
SERVER_HOST=http://localhost
# port to connect and to start server on
SERVER_PORT=3000
# path to database file
DB_PATH=target/db.redb
# origin to allow connections from
# also target to redirect from "/"
WEB_ORIGIN=https://istudyatuni.github.io/ow-tracker/
# full address of website, used in app for loading config
# trailing slash is necessary
WEB_ADDRESS=http://localhost:8080/ow-tracker/
